{
  "name": "dsh-plugin-meeting-minutes",
  "version": "1.4.2",
  "private": false,
  "description": "会议纪要：录音转文字、腾讯会议纪要导入、AI 总结、可视化纪要与待办写入任务日历",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "prepare:speaker-model": "node scripts/prepare-speaker-model.mjs"
  },
  "dependencies": {
    "sherpa-onnx-node": "1.13.8"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "scripts/prepare-speaker-model.mjs"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhangguitao666/meeting-suite.git",
    "directory": "dsh-plugin-meeting-minutes"
  },
  "homepage": "https://github.com/zhangguitao666/meeting-suite/tree/main/dsh-plugin-meeting-minutes"
}
